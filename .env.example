# Copy to .env and fill in your own values. Never commit the real file.
#
# Full JSON-RPC endpoint of your aria2 instance.
ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc

# Optional. Use the same value as `aria2c --rpc-secret=...`.
# Both `secret` and `token:secret` are accepted.
ARIA2_RPC_SECRET=

# Optional per-request timeout in milliseconds (default: 30000).
ARIA2_TIMEOUT_MS=30000
